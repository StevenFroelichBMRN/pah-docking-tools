// Shared config for the PAH pharmacological-chaperone docking pipeline
// (Seqera Platform / AWS Batch, g4dn / NVIDIA T4 GPU queue)

wave.enabled   = true
wave.strategy  = ['container']   // use the upstream prebuilt rbgcsail/diffdock image as-is
docker.enabled = true

params.outdir = 'results'

process {
    cpus   = 4
    memory = '12 GB'

    // let individual DIFFDOCK_BATCH shard tasks fail independently without
    // aborting the whole run; AGGREGATE must NOT be silently ignored, or a
    // real failure there (e.g. a Wave/container/push issue) would be masked
    // as a false "SUCCEEDED" workflow with zero aggregated results.
    withName: 'DIFFDOCK_BATCH' {
        errorStrategy = 'ignore'
    }
    withName: 'AGGREGATE' {
        errorStrategy = 'terminate'
    }
}

executor {
    queueSize = 30
}

process {
    withName: 'BOLTZ2_BATCH' {
        errorStrategy = 'ignore'
    }
}
